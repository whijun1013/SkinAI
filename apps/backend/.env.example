# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=luvel

# Production database URL. When set, it overrides DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=

# JWT Secret Key
# 개발용: 아래 명령어로 생성 후 입력
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# 프로덕션: 팀원에게 직접 전달받거나 위 명령어로 안전하게 생성
JWT_SECRET_KEY=dev-secret-key-for-development-only

# Authlib stores OAuth state in the signed Starlette session cookie.
OAUTH_SESSION_SECRET=your-oauth-session-secret-min-32-chars

# Public backend base URL registered in Google/Kakao/Naver developer consoles.
# Provider callback URLs:
# - http://YOUR_PC_IP:8000/auth/social/google/callback
# - http://YOUR_PC_IP:8000/auth/social/kakao/callback
# - http://YOUR_PC_IP:8000/auth/social/naver/callback
OAUTH_REDIRECT_BASE_URL=http://YOUR_PC_IP:8000

# Mobile app redirect. Use a development build or standalone build for stable
# luvel:// redirects. exp/exps are for Expo Go testing only.
SOCIAL_LOGIN_DEFAULT_REDIRECT_URI=luvel://auth/social
SOCIAL_LOGIN_ALLOWED_REDIRECT_SCHEMES=luvel,exp,exps

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao uses the REST API key as OAuth client_id. KAKAO_CLIENT_SECRET is needed
# when client secret is enabled in the Kakao app settings.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# KAKAO_REST_API_KEY는 KAKAO_CLIENT_ID 대신 사용 가능 (카카오 REST API 키)
KAKAO_REST_API_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=com.luvel.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# OpenAI (OpenAI Direct API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Gemini (Google GenAI API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Skin Analysis Provider (gemini | openai | disabled)
SKIN_ANALYSIS_PROVIDER=gemini

# Admin Dummy Tools
ENABLE_ADMIN_DUMMY_TOOLS=false

# Feature Flags
ENABLE_ACTION_RECOMMENDATIONS=true
ENABLE_FOOD_VISION=false
FOOD_VISION_PROVIDER=openai
FOOD_VISION_DAILY_LIMIT_PER_USER=10
FOOD_VISION_MONTHLY_BUDGET_USD=20.0
FOOD_VISION_CACHE_TTL_DAYS=30

# ── Cosmetic OCR Config ──
# (기본 비활성화, OpenAI Vision 사용. 일별 제한 및 월별 예산)
ENABLE_COSMETIC_OCR=false
COSMETIC_OCR_PROVIDER=openai
COSMETIC_OCR_DAILY_LIMIT_PER_USER=5
COSMETIC_OCR_MONTHLY_BUDGET_USD=10.0
COSMETIC_OCR_CACHE_TTL_DAYS=30

# App Reviewer Account
ENABLE_REVIEW_ACCOUNT_LOGIN=false
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_PASSWORD=
REVIEW_ACCOUNT_NAME=Luvel Reviewer

# CORS Configuration
# 프론트엔드 도메인 (관리자 웹 등)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MedGemma queue configuration (Optional async processing)
MEDGEMMA_QUEUE_ENABLED=false
MEDGEMMA_WORKER_POLL_SECONDS=10
MEDGEMMA_WORKER_MAX_ATTEMPTS=3
MEDGEMMA_STALE_REQUEUE_INTERVAL_MINUTES=60
MEDGEMMA_PRIMARY_VISUAL_MIN_CONFIDENCE=medium

# File Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./uploads

# S3-compatible storage
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# BACKEND BASE URL for external image loading
BACKEND_BASE_URL=http://localhost:8000

# MFDS Public Data API
# Required for running data_tools/fetch_mfds_ingredients.py and fetch_mfds_restrictions.py
MFDS_API_KEY=

# KMA ASOS API Key
KMA_AUTH_KEY=

# KMA Living Weather Index Service API Key (UV Index)
KMA_LIVING_INDEX_SERVICE_KEY=

# AirKorea API Key (PM10/25 dust info)
AIRKOREA_SERVICE_KEY=

# Kakao Local API Key (for Reverse Geocoding)
KAKAO_API_KEY=

# Mock Environment Data Toggle
ALLOW_MOCK_ENVIRONMENT_DATA=false

# MongoDB (AI 분석 원본 결과 저장용)
# Windows: MongoDB Community 설치 시 서비스가 자동 실행됨 (mongod 수동 실행 불필요)
# 로컬: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MongoDB Atlas example for shared MedGemma queue:
# MONGO_URL=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Use the same Atlas URL on backend and H100 worker when testing MedGemma queue E2E.
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=luvel

# Naver Shopping API
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

# MediaPipe Face Detector model path for image quality checks
MEDIAPIPE_FACE_DETECTOR_MODEL=models/mediapipe/blaze_face_short_range.tflite
