# Backend API URL.
# Development: use your PC LAN IP, for example http://192.168.0.10:8000
API_BASE_URL=http://YOUR_PC_IP:8000

# OAuth backend base URL.
# For social-login testing through ngrok, use the HTTPS ngrok URL.
OAUTH_BASE_URL=http://YOUR_PC_IP:8000

# MFDS public data API key for mobile-side experiments only.
EXPO_PUBLIC_MFDS_API_KEY=
